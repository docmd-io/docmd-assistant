{
  "name": "docmd-assistant",
  "version": "0.1.20",
  "description": "Universal headless AI Assistant engine with extensible tool execution and custom relay support.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "docmd": {
    "key": "docmd-assistant",
    "kind": "assistant-engine",
    "displayName": "docmd-assistant",
    "tagline": "Universal headless AI Assistant engine with extensible tool execution."
  },
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node build.js && node tests/sanitizer.test.js && node tests/engine_relay.test.js",
    "typecheck": "npx tsc --noEmit",
    "clean": "rm -rf dist node_modules *.tsbuildinfo > /dev/null 2>&1 || true",
    "prep": "npm run clean && npm install --silent && npm run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "aiplug": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "assistant",
    "ai",
    "chat",
    "widget",
    "documentation",
    "docmd",
    "aiplug",
    "rag"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/docmd-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/docmd-assistant/issues"
  },
  "homepage": "https://docmd.io/assistant",
  "license": "MIT"
}